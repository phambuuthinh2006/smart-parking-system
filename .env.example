# Use `npm run backend:init` to create .env with unique secrets.
POSTGRES_PASSWORD=replace-with-random-password
DEVICE_API_KEY=replace-with-a-random-key-at-least-24-characters
POSTGRES_PORT=55432
API_PORT=18080
# Set 0.0.0.0 only when testing from your ESP8266 on the same LAN.
API_BIND_ADDRESS=127.0.0.1
DEVICE_TIMEOUT_SECONDS=45
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Optional when frontend and backend are hosted separately:
# VITE_BACKEND_URL=https://your-api.example.com

# Enables backend request/demo controls. With esp32_bridge.py running, requests may actuate hardware.
ACCESS_SIMULATION_ENABLED=false

# Optional laptop bridge (not used until you start demo/esp32_bridge.py).
# Must match PARKING_API_KEY in private SmartParking/Config.h. Use a separate key.
ESP32_API_KEY=replace-with-a-separate-random-key-at-least-24-characters
ESP32_URL=http://192.168.4.1
DEVICE_BACKEND_URL=http://127.0.0.1:18080

PARKING_DIRECTION=AUTO
