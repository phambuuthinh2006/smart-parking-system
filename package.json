{
  "name": "smart-parking-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "share": "node scripts/share.mjs",
    "backend:init": "node scripts/init-backend.mjs",
    "backend:up": "npm run backend:init && docker compose up --build -d",
    "backend:down": "docker compose down",
    "backend:logs": "docker compose logs -f backend",
    "device:simulate": "node --env-file=.env scripts/simulate-device.mjs",
    "test:backend": "node --env-file=.env scripts/test-backend.mjs",
    "backend:build": "cd backend && ./mvnw package -DskipTests",
    "backend:local": "node --env-file=.env scripts/run-backend.mjs"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.5.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0"
  }
}
