# Cấu hình địa chỉ Web Backend (chạy trên Laptop 1)
# Khi Laptop 1 kết nối vào Wi-Fi ESP32, kiểm tra IP của Laptop 1 (ipconfig) và điền vào đây.
# Mặc định thường là 192.168.4.2
DEVICE_BACKEND_URL=http://192.168.4.2:18080

# Key bảo mật kết nối với Backend (lấy từ file .env của smart-parking-system trên Laptop 1)
DEVICE_API_KEY=

# Địa chỉ IP của ESP32 (khi ESP32 phát AP thì luôn là 192.168.4.1)
ESP32_URL=http://192.168.4.1

# Hướng cổng của Camera: ENTRY (Lối vào) hoặc EXIT (Lối ra)
PARKING_DIRECTION=AUTO

